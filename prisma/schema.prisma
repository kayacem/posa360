generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  TENANT_STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentStatusEnum {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  SHIPPED_BACK
  RECEIVED
  REFUNDED
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  customDomain  String?  @unique
  status        TenantStatus @default(ACTIVE)
  plan          String   @default("basic")
  
  companyName   String?
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  address       String?
  taxNumber     String?
  
  monthlyFee    Float    @default(0)
  lastPaymentDate DateTime?
  lastPaymentStatus PaymentStatusEnum @default(PENDING)
  nextPaymentDue    DateTime?
  
  logoUrl       String?
  primaryColor  String   @default("#000000")
  secondaryColor String  @default("#ffffff")
  
  currency      String   @default("TRY")
  locale        String   @default("tr-TR")
  timezone      String   @default("Europe/Istanbul")
  taxRate       Float    @default(0.20)
  
  maxProducts   Int      @default(100)
  maxOrders     Int      @default(1000)
  maxStaff      Int      @default(5)
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  users         TenantUser[]
  products      Product[]
  categories    Category[]
  brands        Brand[]
  orders        Order[]
  customers     Customer[]
  pages         Page[]
  menus         Menu[]
  coupons       Coupon[]
  shippingRules ShippingRule[]
  paymentSettings PaymentSetting[]
  taxSettings   TaxSetting[]
  auditLogs     AuditLog[]
  domainVerifications DomainVerification[]
  subscriptionPayments SubscriptionPayment[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tenantUsers   TenantUser[]
}

model TenantUser {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  role        UserRole
  permissions String[]
  
  createdAt   DateTime @default(now())
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  
  email         String
  password      String?
  firstName     String
  lastName      String
  phone         String?
  
  tckn          String?
  vkn           String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses     Address[]
  orders        Order[]
  favorites     Favorite[]
  reviews       Review[]
  
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Address {
  id            String   @id @default(cuid())
  customerId    String
  
  title         String
  firstName     String
  lastName      String
  phone         String
  
  addressLine1  String
  addressLine2  String?
  il            String
  ilce          String
  postalCode    String
  
  isDefault     Boolean  @default(false)
  
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@index([customerId])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    ProductCategory[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  
  name        String
  slug        String
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  
  name          String
  slug          String
  description   String?
  shortDesc     String?
  
  sku           String?
  barcode       String?
  
  price         Float
  compareAtPrice Float?
  costPrice     Float?
  
  trackInventory Boolean  @default(true)
  stock         Int      @default(0)
  lowStockThreshold Int?
  
  hasVariants   Boolean  @default(false)
  
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  
  taxable       Boolean  @default(true)
  
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  
  brandId       String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand         Brand?     @relation(fields: [brandId], references: [id])
  images        ProductImage[]
  categories    ProductCategory[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  favorites     Favorite[]
  reviews       Review[]
  
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  altText     String?
  sortOrder   Int      @default(0)
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
}

model ProductCategory {
  productId   String
  categoryId  String
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([productId, categoryId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  
  name        String
  sku         String?
  barcode     String?
  
  price       Float?
  stock       Int      @default(0)
  
  isActive    Boolean  @default(true)
  
  options     String
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
}

model Favorite {
  id          String   @id @default(cuid())
  customerId  String
  productId   String
  
  createdAt   DateTime @default(now())
  
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([customerId, productId])
}

model Review {
  id          String   @id @default(cuid())
  customerId  String
  productId   String
  
  rating      Int
  title       String?
  comment     String?
  
  isApproved  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
}

model Order {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String
  
  orderNumber   String   @unique
  
  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  
  subtotal      Float
  shippingCost  Float    @default(0)
  taxAmount     Float
  discountAmount Float   @default(0)
  total         Float
  
  customerEmail    String
  customerName     String
  customerPhone    String?
  
  shippingAddress  String
  billingAddress   String?
  
  customerNote     String?
  staffNote        String?
  
  couponCode       String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]
  returns       Return[]
  
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  
  productName   String
  variantName   String?
  sku           String?
  
  quantity      Int
  price         Float
  total         Float
  
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
  
  @@index([orderId])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  
  status      OrderStatus
  note        String?
  
  createdAt   DateTime @default(now())
  createdBy   String?
  
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  
  provider        String
  method          String
  
  amount          Float
  currency        String   @default("TRY")
  
  status          PaymentStatus @default(PENDING)
  
  providerTransactionId String?
  providerResponse      String?
  
  bankName        String?
  accountHolder   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
}

model PaymentSetting {
  id          String   @id @default(cuid())
  tenantId    String
  
  provider    String
  isActive    Boolean  @default(false)
  isSandbox   Boolean  @default(true)
  
  credentials String
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, provider])
}

model Shipment {
  id              String   @id @default(cuid())
  orderId         String
  
  carrier         String
  trackingNumber  String?
  trackingUrl     String?
  
  status          ShipmentStatus @default(PREPARING)
  
  labelUrl        String?
  trackingHistory String?
  
  weight          Float?
  desi            Float?
  
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
}

model ShippingRule {
  id          String   @id @default(cuid())
  tenantId    String
  
  name        String
  type        String
  
  minOrderAmount Float?
  maxWeight      Float?
  
  cost        Float    @default(0)
  
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

model Return {
  id            String   @id @default(cuid())
  orderId       String
  
  returnNumber  String   @unique
  
  reason        String
  description   String?
  images        String[]
  
  status        ReturnStatus @default(REQUESTED)
  
  items         String
  
  approvedAt    DateTime?
  approvedBy    String?
  rejectedReason String?
  
  returnTrackingNumber String?
  returnCarrier        String?
  
  refundAmount  Float?
  refundedAt    DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([orderId])
}

model Coupon {
  id            String   @id @default(cuid())
  tenantId      String
  
  code          String
  description   String?
  
  type          String
  value         Float
  
  minOrderAmount Float?
  maxDiscountAmount Float?
  usageLimit    Int?
  usageCount    Int      @default(0)
  
  startsAt      DateTime?
  endsAt        DateTime?
  
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Page {
  id          String   @id @default(cuid())
  tenantId    String
  
  title       String
  slug        String
  content     String
  
  isActive    Boolean  @default(true)
  
  metaTitle       String?
  metaDescription String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Menu {
  id          String   @id @default(cuid())
  tenantId    String
  
  name        String
  location    String
  
  items       String
  
  isActive    Boolean  @default(true)
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, location])
  @@index([tenantId])
}

model TaxSetting {
  id          String   @id @default(cuid())
  tenantId    String
  
  name        String
  rate        Float
  
  isDefault   Boolean  @default(false)
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

model DomainVerification {
  id          String   @id @default(cuid())
  tenantId    String
  
  domain      String   @unique
  
  verificationToken String @default(cuid())
  isVerified   Boolean  @default(false)
  verifiedAt   DateTime?
  
  sslStatus    String   @default("pending")
  sslProvider  String?
  
  requiredRecords String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

model SubscriptionPayment {
  id          String   @id @default(cuid())
  tenantId    String
  
  amount      Float
  currency    String   @default("TRY")
  
  status      PaymentStatusEnum @default(PENDING)
  
  periodStart DateTime
  periodEnd   DateTime
  
  paidAt      DateTime?
  dueDate     DateTime
  
  paymentMethod String?
  
  invoiceNumber String?
  notes         String?
  
  createdAt   DateTime @default(now())
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  
  userId      String
  action      String
  entity      String
  entityId    String
  
  changes     String?
  
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
}
