{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
		interval 2m
		burst 5
	}
}

# IMPORTANT: Do NOT claim posa360.com or www — marketing site lives on apex elsewhere.
# Per-host certs for platform subdomains (app, admin, stores). Not a single wildcard cert.
*.posa360.com {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}

# Merchant custom domains (ask endpoint rejects platform apex/www)
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}
