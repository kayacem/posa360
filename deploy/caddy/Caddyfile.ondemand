{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
		interval 2m
		burst 5
	}
}

# Platform + all hostnames via On-Demand TLS (per-host certs, no DNS plugin needed).
# Note: this does NOT issue a single wildcard cert; each subdomain gets its own cert.
posa360.com, *.posa360.com, https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}
