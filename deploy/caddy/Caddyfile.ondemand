{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
		interval 2m
		burst 5
	}
}

# Marketing apex + www + platform subdomains (per-host certs)
posa360.com, www.posa360.com, *.posa360.com {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}

# Merchant custom domains
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}
