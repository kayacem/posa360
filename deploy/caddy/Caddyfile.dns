{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
		interval 2m
		burst 5
	}
}

# Marketing apex + www + all platform subdomains (wildcard via Cloudflare DNS)
posa360.com, www.posa360.com, *.posa360.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode gzip
	reverse_proxy app:3000
}

# Merchant custom domains (On-Demand TLS)
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}
