# === Kopyala: cp .env.production.example .env.production ===
# Gerçek sırları buraya yazın; bu dosyayı git'e eklemeyin.

# Postgres (docker-compose.prod.yml)
POSTGRES_USER=posa360
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=posa360

# App
NODE_ENV=production
DATABASE_URL=postgresql://posa360:change-me-strong-password@postgres:5432/posa360?schema=public
NEXTAUTH_SECRET=change-me-min-32-chars-random-string-here
# trustHost=true olduğu için çoklu domain çalışır; yine de varsayılan URL:
NEXTAUTH_URL=https://posa360.com
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://posa360.com
NEXT_PUBLIC_PLATFORM_DOMAIN=posa360.com

# Caddy / TLS
# TLS_MODE=dns      → Cloudflare DNS challenge ile *.posa360.com wildcard sertifika
# TLS_MODE=ondemand → her hostname için ayrı On-Demand TLS (CLOUDFLARE gerekmez)
TLS_MODE=ondemand
ACME_EMAIL=admin@posa360.com
# Sadece TLS_MODE=dns iken zorunlu:
CLOUDFLARE_API_TOKEN=

# İlk açılışta opsiyonel super admin (demo veri YOK)
SEED_SUPER_ADMIN_EMAIL=admin@posa360.com
SEED_SUPER_ADMIN_PASSWORD=change-me-admin-password
SEED_SUPER_ADMIN_NAME=Platform Admin
