# === /opt/posa/apps/eticaret/.env ===
# Native Postgres on 127.0.0.1 — create role + DB first (see docs/DEPLOY.md)

NODE_ENV=production
PORT=3030
HOSTNAME=127.0.0.1
NODE_OPTIONS=--max-old-space-size=384

DATABASE_URL=postgresql://posa_eticaret:CHANGE_ME@127.0.0.1:5432/posa_eticaret?schema=public

NEXTAUTH_SECRET=change-me-min-32-chars-random-string-here
NEXTAUTH_URL=https://eticaret.posa360.com
AUTH_TRUST_HOST=true

NEXT_PUBLIC_PLATFORM_DOMAIN=posa360.com
NEXT_PUBLIC_HUB_SUBDOMAIN=eticaret
NEXT_PUBLIC_APP_URL=https://eticaret.posa360.com
NEXT_PUBLIC_MARKETING_URL=https://eticaret.posa360.com

# Shared secret for /api/internal/pending-certs (root cert cron)
CERT_AGENT_SECRET=change-me-long-random-cert-agent-secret
ACME_EMAIL=admin@posa360.com

# Optional first-boot seed (super admin)
SEED_SUPER_ADMIN_EMAIL=admin@posa360.com
SEED_SUPER_ADMIN_PASSWORD=change-me-admin-password
SEED_SUPER_ADMIN_NAME=Platform Admin

# Dev-only: SKIP_DNS_VERIFY=1
